# Copy to .env and fill in real values. .env is gitignored; this file is committed.
# docker compose reads .env automatically from the project folder.

# Database name used by the docker-compose db and app services (defaults to taskflowdb)
POSTGRES_DB=taskflowdb

# Database password for the postgres user. Required: compose stops if it is missing.
POSTGRES_PASSWORD=change-me

# OPENAI_API_KEY is not stored here. Keep it in your shell environment.
