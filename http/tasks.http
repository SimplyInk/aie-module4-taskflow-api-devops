// -------------------------------------------------
// Update Task
// -------------------------------------------------

### Update task by id
PUT {{baseUrl}}/api/tasks/1
Content-Type: application/json

{
  "title": "Complete Module 3 - Updated",
  "description": "Finish assignment with updates",
  "priority": "MEDIUM",
  "dueDate": "2026-05-25",
  "completed": false
}

/*
HTTP/1.1 200 
Content-Type: application/json
Transfer-Encoding: chunked
Date: Mon, 21 Sep 2026 09:42:29 GMT
Connection: close

{
  "title": "Complete Module 3 - Updated",
  "completed": false,
  "description": "Finish assignment with updates",
  "priority": "MEDIUM",
  "dueDate": "2026-05-25",
  "id": 1
}

*/

### Complete task by id
PUT {{baseUrl}}/api/tasks/2/complete

/*
HTTP/1.1 200 
Content-Type: application/json
Transfer-Encoding: chunked
Date: Mon, 21 Sep 2026 09:42:49 GMT
Connection: close

{
  "title": "Walk Dog",
  "completed": true,
  "description": "Take the dog for a walk in the park",
  "priority": "MEDIUM",
