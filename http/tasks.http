@baseUrl = http://localhost:8088

// -------------------------------------------------
// Create Task
// -------------------------------------------------

### Create task
POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "title": "Complete Module 3",
  "description": "Finish assignment",
  "priority": "HIGH",
  "dueDate": "2026-05-20",
  "completed": false
}

/*
HTTP/1.1 201 
Content-Type: application/json
Transfer-Encoding: chunked
Date: Mon, 21 Sep 2026 08:43:00 GMT
Connection: close

{
  "title": "Complete Module 3",
  "completed": false,
  "description": "Finish assignment",
  "priority": "HIGH",
  "dueDate": "2026-05-20",
  "id": 1
}
*/

